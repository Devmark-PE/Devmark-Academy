{
  "name": "devmark-academy",
  "version": "1.0.0",
  "private": true,
  "description": "academy.devmarkpe.com: el sitio de DEVMARK Academy. Sin base de datos: lee el catalogo y envia las inscripciones a la API del ERP.",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build && node scripts/empaquetar-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "^5.9.3"
  }
}
