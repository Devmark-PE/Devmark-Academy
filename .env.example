# Nombres de las variables (los valores van en hPanel de Hostinger, nunca en el repositorio).
# API del ERP, la unica fuente de datos del sitio (decision 0007 del ERP).
ERP_API_URL=https://api.devmarkpe.com
# El mismo secreto que la web (devmarkpe.com) usa para firmar sus llamadas a /api/v1/publico/sitios.
SITIO_SIGNING_SECRET=
# Slug del sitio de la academia en el CMS del ERP (por defecto "academia").
ACADEMIA_SITIO_SLUG=academia
